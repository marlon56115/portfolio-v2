---
// Contacto + footer a sangre en añil: pregunta gigante, CTA, Direct / Elsewhere, nombre en glifos
// de tejido (fx/pixelname.ts), fila legal y franja final con su pie.
import type { Lang } from '../i18n';
import { dict } from '../i18n';
import { availability } from '../i18n/contact';
import Weave from './Weave.astro';

interface Props {
  lang: Lang;
  version: string;
}
const { lang, version } = Astro.props;
const t = dict[lang];
const c = t.contact;
const led = { open: 'led--ok', limited: 'led--warn', closed: '' }[availability];
---

<footer class="site-footer tone-flood" id="contact" aria-labelledby="contact-title">
  <canvas class="dye" data-dye aria-hidden="true"></canvas>
  <Weave motif="izote" lang={lang} caption />
  <div class="shell contact">
    <div class="contact__main">
      <h2 class="display contact__title" id="contact-title"><span class="mask"><span>{c.title}</span></span></h2>
      <p class="label" data-reveal>{c.based}</p>
      <p class="label contact__status" data-reveal><span class:list={['led', led]} aria-hidden="true" />{c.status[availability]}</p>
      <a class="btn-solid cut label" href={`mailto:${t.email}`} data-magnet data-reveal>
        {c.send} <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="contact__cols" data-reveal>
      <div>
        <h3 class="label">{c.direct}</h3>
        <ul>
          <li><a class="contact__link" href={`mailto:${t.email}`}>{t.email}</a></li>
          <li>
            <button class="contact__link" type="button" data-copy={t.email} data-copied={c.copied}>{c.copy}</button>
            <span class="sr-only" role="status" data-copy-live data-msg={c.copiedLive}></span>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="label">{c.elsewhere}</h3>
        <ul>
          <li>
            <a class="contact__link" href={t.linkedin} rel="noopener noreferrer" target="_blank">{c.linkedinHandle} <span aria-hidden="true">↗</span><span class="sr-only"> ({c.external})</span></a>
          </li>
          <li>
            <a class="contact__link" href={t.github} rel="noopener noreferrer" target="_blank">{c.githubHandle} <span aria-hidden="true">↗</span><span class="sr-only"> ({c.external})</span></a>
          </li>
        </ul>
      </div>
      <p class="contact__note">{c.note}</p>
    </div>
  </div>

  <div class="pixelname shell">
    <canvas data-pixelname={t.first.toUpperCase()} role="img" aria-label={c.nameLabel}></canvas>
  </div>

  <div class="legal shell label">
    <p>© <span data-year>{new Date().getFullYear()}</span> {t.fullName}</p>
    <p>{t.footer.built} · {t.footer.version}{version}</p>
    <a class="more" href="#top" data-magnet>{t.ui.backToTop} <span class="arrow arrow--up" aria-hidden="true">↑</span></a>
  </div>

  <Weave motif="olas" lang={lang} />
  <p class="weave-cap weave-cap--end label shell">
    <span>{t.weave.from} “{t.city}, SV · {t.coords}” · <span lang="es">{t.weave.captions.olas.word}</span>, {t.weave.captions.olas.meaning}</span>
    <span>{t.weave.closing} {t.footer.line}</span>
  </p>
</footer>
