---
// Toolkit: sección a sangre en añil. Una fila por disciplina: etiqueta mono + chips blancos con logo.
import type { Lang } from '../i18n';
import { dict } from '../i18n';
import { icon, monogram } from '../lib/icons';
import Weave from './Weave.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
// Orden por peso: primero operación, después desarrollo.
const order = ['infra', 'cloud', 'ai', 'languages', 'backend', 'data', 'frontend', 'quality'];
const groups = [...t.toolkit.groups].sort((a, b) => order.indexOf(a.k) - order.indexOf(b.k));
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<section class="section toolkit tone-flood" id="toolkit" aria-labelledby="toolkit-title">
  <canvas class="dye" data-dye aria-hidden="true"></canvas>
  <Weave motif="greca" lang={lang} caption />
  <div class="shell">
    <header class="sec-head">
      <h2 class="display" id="toolkit-title"><span class="mask"><span>{t.toolkit.title}</span></span></h2>
      <p class="label" data-reveal>
        <span data-count={total}>{total}</span> {t.toolkit.tools} · <span data-count={groups.length}>{groups.length}</span> {t.toolkit.disciplines}
      </p>
    </header>
    <div class="toolkit__rows">
      {
        groups.map((g) => (
          <div class="toolkit__row" data-reveal-group>
            <h3 class="label toolkit__label">{g.t}</h3>
            <ul class="toolkit__chips">
              {g.items.map((tool) => {
                const ic = icon(tool.n);
                return (
                  <li class="chip" data-reveal-item>
                    <span class="chip__logo cut" aria-hidden="true">
                      {ic ? (
                        <svg viewBox="0 0 24 24" width="18" height="18" fill={`#${ic.hex}`} focusable="false">
                          <path d={ic.path} />
                        </svg>
                      ) : (
                        <span class="chip__mono">{monogram(tool.n)}</span>
                      )}
                    </span>
                    <span class="chip__name">{tool.n}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
