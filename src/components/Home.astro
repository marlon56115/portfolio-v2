---
// Página principal (una por idioma). El orden de las secciones es el de DESIGN.md §5.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Menu from './Menu.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Toolkit from './Toolkit.astro';
import Work from './Work.astro';
import Experience from './Experience.astro';
import Recognition from './Recognition.astro';
import Contact from './Contact.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// La pone el Dockerfile al construir; en local se ve "dev".
const version = process.env.BUILD_VERSION || 'dev';
---

<Base lang={lang}>
  <Header lang={lang} />
  <Menu lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <About lang={lang} />
    <Toolkit lang={lang} />
    <Work lang={lang} />
    <Experience lang={lang} />
    <Recognition lang={lang} />
  </main>
  <Contact lang={lang} version={version} />
</Base>

<script>
  import '../scripts/main';
</script>
