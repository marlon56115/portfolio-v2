---
// Header fijo (HUD): logo achaflanado + nombre · MODE LIGHT/DARK · franja de tejido · hora de SV · idioma · MENU.
// Se esconde al bajar y vuelve al subir (core/hud.ts). Debajo, la barra de progreso de lectura "tejida".
import type { Lang } from '../i18n';
import { dict } from '../i18n';
import Weave from './Weave.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
---

<header class="hud" data-hud>
  <div class="hud__in shell">
    <a class="hud__logo label" href="#top">
      <span class="logo cut" aria-hidden="true">{t.initials}</span>
      <span>{t.name}</span>
      <span class="sr-only">— {t.ui.home}</span>
    </a>
    <button class="hud__mode label" type="button" data-theme-toggle aria-label={t.ui.themeToggle}>
      <span class="muted">{t.ui.mode}</span>
      <span data-theme-label data-light={t.ui.themeLight} data-dark={t.ui.themeDark}>{t.ui.themeLight}</span>
    </button>
    <div class="hud__band"><Weave motif="anil" lang={lang} size="thin" /></div>
    <p class="hud__clock label">
      <span class="muted" aria-hidden="true">SV</span>
      <span class="sr-only">{t.ui.localTime}</span>
      <time data-clock>--:--</time>
    </p>
    <a class="hud__lang label" href={`/${other}/`} hreflang={other} lang={other} data-set-lang={other}>
      <span class="sr-only">{t.ui.language}: </span>{other}
    </a>
    <button class="hud__menu btn-outline label" type="button" data-menu-open aria-haspopup="dialog" data-magnet>{t.ui.menu}</button>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>
