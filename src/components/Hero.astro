---
// Hero: chip + línea + intro (izq.) · retrato en duotono pixelado entre dos franjas (centro) ·
// "desde ’XX" (der.) · nombre gigante partido en dos + SCROLL (abajo). En móvil se apila.
import { getImage } from 'astro:assets';
import cutout from '../assets/hero/marlon-cutout.webp';
import type { Lang } from '../i18n';
import { dict, careerStart } from '../i18n';
import Weave from './Weave.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const img = await getImage({ src: cutout, width: 720, format: 'webp', quality: 72 });
const year = careerStart.slice(2, 4);
// "[Kubernetes]" → resaltado en añil.
const intro = t.hero.intro.split(/(\[[^\]]+\])/).filter(Boolean);
const letters = (w: string) => w.toUpperCase().split('');
---

<section class="hero shell" id="hero" data-hero>
  <div class="hero__copy">
    <p class="hero__chip label cut" data-in="1">{t.hero.chip}</p>
    <p class="hero__line label muted" data-in="2">{t.hero.line}</p>
    <p class="hero__intro" data-in="3">
      {intro.map((part) => (part.startsWith('[') ? <span class="accent">{part.slice(1, -1)}</span> : part))}
    </p>
  </div>

  <figure class="portrait" data-portrait data-in="0">
    <Weave motif="anil" lang={lang} size="frame" />
    <div class="portrait__field">
      <img class="portrait__img" src={img.src} width="720" height="720" alt={t.hero.photoAlt} decoding="async" fetchpriority="high" />
      <canvas class="portrait__canvas" aria-hidden="true"></canvas>
    </div>
    <Weave motif="anil" lang={lang} size="frame" />
  </figure>

  <p class="hero__since" data-in="2">
    <span class="label muted">{t.hero.since}</span>
    <span class="display hero__year">’<span data-count={year}>{year}</span></span>
  </p>

  <h1 class="display hero__name" aria-label={t.name} data-name>
    <span class="hero__half hero__half--l" aria-hidden="true">{letters(t.first).map((ch) => <span class="ch"><span class="ch__in">{ch}</span></span>)}</span>
    <span class="hero__half hero__half--r" aria-hidden="true">{letters(t.last).map((ch) => <span class="ch"><span class="ch__in">{ch}</span></span>)}</span>
  </h1>

  <p class="hero__scroll label muted" aria-hidden="true"><span class="hero__scroll-line"></span>{t.ui.scroll}</p>
</section>
