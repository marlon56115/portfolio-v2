---
// Documento base de las páginas por idioma.
// CSP: nada inline. El único <script> clásico es el externo /theme-init.js.
import '../styles/global.css';
// URL con hash de la fuente display, para precargarla (es el mismo archivo que usa fonts.css).
import displayFont from '@fontsource/chakra-petch/files/chakra-petch-latin-600-normal.woff2?url';
import type { Lang } from '../i18n';
import { dict } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${site}/${lang}/`;
const ogImage = `${site}/og.png`;
---

<!doctype html>
<html lang={t.htmlLang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={t.fullName} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f5f7" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={`${site}/es/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/en/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_SV' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Tema, intro y clase de movimiento antes de pintar. Archivo externo: la CSP no permite scripts inline. -->
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body id="top">
    <!-- Cloudflare no reescribe correos dentro de email_off: su decodificador usaría innerHTML y la CSP lo bloquea. -->
    <Fragment set:html="<!--email_off-->" />
    <a class="skip label" href="#main">{t.ui.skip}</a>
    <div class="rails" aria-hidden="true"></div>
    <!-- Intro de primera visita: una hebra cruza la pantalla y teje el logo. Solo CSS (html.intro). -->
    <div class="intro" aria-hidden="true">
      <div class="intro__half intro__half--a"></div>
      <div class="intro__half intro__half--b"></div>
      <div class="intro__thread"></div>
      <div class="intro__mark"><span class="intro__logo cut">{t.initials}</span><span class="label intro__name">{t.name}</span></div>
    </div>
    <slot />
    <p class="toast label" role="status" data-toast data-vat-on={t.ui.vat} data-vat-off={t.ui.vatOff}></p>
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
