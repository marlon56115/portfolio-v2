---
// 404 bilingüe. El servidor Go la sirve en cualquier ruta desconocida, así que las URLs son absolutas.
import '../styles/global.css';
import { dict } from '../i18n';
import Weave from '../components/Weave.astro';
const es = dict.es.notFound;
const en = dict.en.notFound;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>404 · Marlon Guerra</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <div class="rails" aria-hidden="true"></div>
    <main class="shell plain">
      <p class="label muted">HTTP 404</p>
      <h1 class="display plain__code">404</h1>
      <Weave motif="greca" lang="en" />
      <div class="plain__cols">
        <section lang="en">
          <h2 class="display">{en.title}</h2>
          <p class="muted">{en.body}</p>
          <a class="more label" href="/en/">{en.home} <span class="arrow" aria-hidden="true">→</span></a>
        </section>
        <section lang="es">
          <h2 class="display">{es.title}</h2>
          <p class="muted">{es.body}</p>
          <a class="more label" href="/es/">{es.home} <span class="arrow" aria-hidden="true">→</span></a>
        </section>
      </div>
    </main>
    <script>
      import '../scripts/plain';
    </script>
  </body>
</html>
